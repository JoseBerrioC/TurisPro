# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Seguridad y Autenticación
JWT_SECRET=turispro_seguridad_clave_secreta_jwt_2026

# Base de Datos SQLite (Ruta personalizada opcional)
# DB_PATH=./turispro.db

# Integración con Modelo de Lenguaje (LLM / Google Gemini)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=25000

# OBLIGATORIO para generar análisis redactados por IA real (Google Gemini).
# Preferiblemente pega la clave en backend/secrets/.env. Este archivo se conserva por compatibilidad.
# Nunca pongas esta clave en archivos del frontend ni la compartas públicamente.
